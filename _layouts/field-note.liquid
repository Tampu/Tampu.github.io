---
layout: page
---
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/field-notes/field-notes.css' | relative_url }}?v=9">

{% assign sec = site.data.field_notes.sections | where: 'id', page.section | first %}
<article class="fn fn-entry{% if page.section == 'bigger-questions' %} fn-entry-cosmos{% endif %}">
  <header class="fn-entry-head">
    <a class="back" href="{{ '/field-notes/' | relative_url }}#{{ page.section }}">← Field Notes</a>
    <p class="fn-kicker" style="margin-top: 1.4rem">{{ sec.name }}{% if page.number %} · {{ page.number }}{% endif %} · {{ page.date | date: '%-d %b %Y' | upcase }}</p>
    <h1>{{ page.title }}</h1>
    {% if page.standfirst %}<p class="stand">{{ page.standfirst }}</p>{% endif %}
    {% if page.subtitle %}<p class="stand">{{ page.subtitle }}</p>{% endif %}
    {% if page.status %}<p class="fn-status"><span class="status">{{ page.status }}</span>{{ page.status_note }}</p>{% endif %}
  </header>

  {% if page.cover %}
    <figure class="fn-print" style="--ar: 4 / 5; margin-bottom: 1rem; max-width: 30rem">
      {% if page.cover.file != '' %}
        <img src="{{ page.cover.file | prepend: '/assets/field-notes/' | relative_url }}" alt="{{ page.cover.label }}" loading="lazy">
      {% else %}
        <div class="ph"><div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h4l2-3h6l2 3h4v13H3z"/><circle cx="12" cy="13" r="4"/></svg><span class="fn-hand">{{ page.cover.label }} goes here</span></div></div>
      {% endif %}
    </figure>
  {% endif %}

  {{ content }}

  {% if page.photos %}
    <div class="fn-lens fn-roll" style="margin-top: 2rem">
      {% for ph in page.photos %}
        {% if ph.file != '' %}
          <figure class="fn-print film" style="--ar: {{ ph.ratio | default: '3 / 4' }}">
            <span class="frame-no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}K</span>
            <img src="{{ ph.file | prepend: '/assets/field-notes/' | relative_url }}" alt="{{ ph.label }}" loading="lazy">
            <figcaption>{{ ph.label }}</figcaption>
          </figure>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  <footer class="fn-entry-foot">
    <a href="{{ '/field-notes/' | relative_url }}">← Back to Field Notes</a>
    <span>Filed under {{ sec.name | downcase }}</span>
  </footer>
</article>
